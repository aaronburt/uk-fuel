{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "uk-fuel",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-23",
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "FUEL_CACHE",
			"id": "f68e086b206d491ca46d779135258786"
		}
	],
	"triggers": {
		"crons": [
			"0 */6 * * *"
		]
	}
}